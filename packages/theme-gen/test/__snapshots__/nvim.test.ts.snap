// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`nvim groups snapshot 1`] = `
"-- uiu — nvim colorscheme (light)
-- generated by packages/theme-gen from theme/*.css — do not edit by hand

local M = {}

-- роли theme/roles.css: имя через подчёркивание → hex (в комментарии — ступень палитры)
M.colors = {
  surface_sunken        = "#f2f2f2", -- GRAY-96
  surface_base          = "#ffffff", -- GRAY-100
  surface_chrome        = "#ebebeb", -- GRAY-94
  surface_overlay       = "#f8f8f8", -- GRAY-98
  surface_modal         = "#ffffff", -- GRAY-100
  surface_sunken_hover  = "#ebebeb", -- GRAY-94
  surface_base_hover    = "#f2f2f2", -- GRAY-96
  surface_chrome_hover  = "#e0e0e0", -- GRAY-91
  surface_overlay_hover = "#ebebeb", -- GRAY-94
  border_subtle         = "#e0e0e0", -- GRAY-91
  border_strong         = "#535353", -- GRAY-44
  border_modal          = "#292929", -- GRAY-28
  text                  = "#292929", -- GRAY-28
  text_strong           = "#000000", -- GRAY-0
  text_muted            = "#535353", -- GRAY-44
  text_faint            = "#7a7a7a", -- GRAY-58
  text_disabled         = "#a4a4a4", -- GRAY-72
  text_on_accent        = "#ffffff", -- GRAY-100
  syntax_keyword        = "#a4a4a4", -- GRAY-72
  syntax_type           = "#a4a4a4", -- GRAY-72
  syntax_comment        = "#a4a4a4", -- GRAY-72
  syntax_function       = "#292929", -- GRAY-28
  syntax_variable       = "#292929", -- GRAY-28
  syntax_string         = "#292929", -- GRAY-28
  syntax_constant       = "#292929", -- GRAY-28
  syntax_punctuation    = "#292929", -- GRAY-28
  accent_selection      = "#e2f0ff", -- BLUE-95
  accent_menu_selection = "#e0e0e0", -- GRAY-91
  accent_search         = "#cecece", -- GRAY-85
  accent_search_current = "#009bff", -- BLUE
  accent_match          = "#0266ab", -- BLUE-50
  accent_interactive    = "#009bff", -- BLUE
  state_added           = "#017746", -- GREEN-50
  state_added_bg        = "#daf7e4", -- GREEN-95
  state_changed         = "#0266ab", -- BLUE-50
  state_changed_bg      = "#e2f0ff", -- BLUE-95
  state_removed         = "#bc0001", -- RED-50
  state_removed_bg      = "#fee9e5", -- RED-95
  state_error           = "#bc0001", -- RED-50
  state_error_bg        = "#fee9e5", -- RED-95
  state_warning         = "#8d5402", -- ORANGE-50
  state_warning_bg      = "#ffebd8", -- ORANGE-95
  state_info            = "#0266ab", -- BLUE-50
  state_info_bg         = "#e2f0ff", -- BLUE-95
  state_hint            = "#a4a4a4", -- GRAY-72
  marker_invisible      = "#ff00ff", -- MAGENTA
  marker_whitespace     = "#cecece", -- GRAY-85
  ansi_black            = "#292929", -- GRAY-28
  ansi_red              = "#bc0001", -- RED-50
  ansi_green            = "#017746", -- GREEN-50
  ansi_yellow           = "#8d5402", -- ORANGE-50
  ansi_blue             = "#0040ff", -- BLUE-DARK
  ansi_magenta          = "#a202a2", -- MAGENTA-50
  ansi_cyan             = "#0266ab", -- BLUE-50
  ansi_white            = "#cecece", -- GRAY-85
  ansi_bright_black     = "#7a7a7a", -- GRAY-58
  ansi_bright_red       = "#ff0000", -- RED
  ansi_bright_green     = "#00ff9b", -- GREEN
  ansi_bright_yellow    = "#ff9b00", -- ORANGE
  ansi_bright_blue      = "#0040ff", -- BLUE-DARK
  ansi_bright_magenta   = "#ff00ff", -- MAGENTA
  ansi_bright_cyan      = "#009bff", -- BLUE
  ansi_bright_white     = "#ffffff", -- GRAY-100
}

local c = M.colors

M.groups = {
  Normal = { fg = c.text, bg = c.surface_base },
  NormalNC = { fg = c.text, bg = c.surface_sunken },
  NormalFloat = { fg = c.text, bg = c.surface_overlay },
  FloatBorder = { fg = c.border_strong, bg = c.surface_overlay },
  FloatTitle = { fg = c.text_strong, bg = c.surface_overlay },
  FloatFooter = { fg = c.text_faint, bg = c.surface_overlay },
  FloatShadow = { bg = c.border_strong, blend = 80 },
  FloatShadowThrough = { bg = c.border_strong, blend = 100 },
  StatusLine = { fg = c.text_muted, bg = c.surface_chrome },
  StatusLineNC = { fg = c.text_faint, bg = c.surface_chrome },
  TabLine = { fg = c.text_muted, bg = c.surface_chrome },
  TabLineSel = { fg = c.text_strong, bg = c.surface_base },
  WinBar = { fg = c.text_muted },
  WinBarNC = { fg = c.text_faint },
  WinSeparator = { fg = c.border_subtle },
  MsgSeparator = { link = "WinSeparator" },
  LineNr = { fg = c.text_faint },
  CursorLineNr = { fg = c.text_strong },
  SignColumn = { fg = c.text_faint },
  Folded = { fg = c.text_muted, bg = c.surface_sunken },
  CursorLine = { bg = c.surface_base_hover },
  CursorColumn = { bg = c.surface_base_hover },
  ColorColumn = { bg = c.surface_base_hover },
  Cursor = { fg = c.surface_base, bg = c.text },
  lCursor = { link = "Cursor" },
  NonText = { fg = c.marker_invisible },
  Whitespace = { fg = c.marker_whitespace },
  EndOfBuffer = { fg = c.marker_whitespace },
  SpecialKey = { fg = c.text_faint },
  Conceal = { fg = c.text_faint },
  Visual = { bg = c.accent_selection },
  Search = { fg = c.text, bg = c.accent_search },
  CurSearch = { fg = c.text_on_accent, bg = c.accent_search_current },
  MatchParen = { fg = c.text_strong, underline = true },
  QuickFixLine = { bg = c.accent_menu_selection },
  Pmenu = { fg = c.text, bg = c.surface_overlay },
  PmenuSel = { fg = c.text_strong, bg = c.accent_menu_selection },
  PmenuKind = { fg = c.text_faint, bg = c.surface_overlay },
  PmenuKindSel = { fg = c.text_faint, bg = c.accent_menu_selection },
  PmenuExtra = { fg = c.text_faint, bg = c.surface_overlay },
  PmenuExtraSel = { fg = c.text_faint, bg = c.accent_menu_selection },
  PmenuMatch = { fg = c.accent_match, bg = c.surface_overlay },
  PmenuMatchSel = { fg = c.accent_match, bg = c.accent_menu_selection },
  PmenuThumb = { bg = c.text_disabled },
  PmenuBorder = { link = "FloatBorder" },
  ComplHint = { fg = c.text_faint },
  ErrorMsg = { fg = c.state_error },
  WarningMsg = { fg = c.state_warning },
  OkMsg = { fg = c.state_added },
  ModeMsg = { fg = c.text_muted },
  MoreMsg = { fg = c.text_muted },
  Question = { fg = c.text_strong },
  Title = { fg = c.text_strong },
  Directory = { fg = c.text_strong },
  DiffAdd = { bg = c.state_added_bg },
  DiffChange = { bg = c.state_changed_bg },
  DiffDelete = { fg = c.state_removed, bg = c.state_removed_bg },
  DiffText = { fg = c.state_changed, bg = c.state_changed_bg },
  Added = { fg = c.state_added },
  Changed = { fg = c.state_changed },
  Removed = { fg = c.state_removed },
  SpellBad = { undercurl = true, sp = c.state_error },
  SpellCap = { undercurl = true, sp = c.state_warning },
  SpellLocal = { undercurl = true, sp = c.state_info },
  SpellRare = { undercurl = true, sp = c.state_hint },
  DiagnosticError = { fg = c.state_error },
  DiagnosticWarn = { fg = c.state_warning },
  DiagnosticInfo = { fg = c.state_info },
  DiagnosticHint = { fg = c.state_hint },
  DiagnosticOk = { fg = c.state_added },
  DiagnosticUnderlineError = { undercurl = true, sp = c.state_error },
  DiagnosticUnderlineWarn = { undercurl = true, sp = c.state_warning },
  DiagnosticUnderlineInfo = { undercurl = true, sp = c.state_info },
  DiagnosticUnderlineHint = { undercurl = true, sp = c.state_hint },
  DiagnosticUnderlineOk = { undercurl = true, sp = c.state_added },
  DiagnosticDeprecated = { strikethrough = true },
  LspInlayHint = { fg = c.text_disabled },
  LspCodeLens = { fg = c.text_disabled },
  Comment = { fg = c.syntax_comment, italic = true },
  Constant = { fg = c.syntax_constant },
  String = { fg = c.syntax_string },
  Identifier = { fg = c.syntax_variable },
  ["@variable"] = { fg = c.syntax_variable },
  Function = { fg = c.syntax_function },
  Statement = { fg = c.syntax_keyword },
  PreProc = { fg = c.syntax_keyword },
  Type = { fg = c.syntax_type },
  Special = { fg = c.syntax_constant },
  Operator = { fg = c.syntax_punctuation },
  Delimiter = { fg = c.syntax_punctuation },
  Todo = { fg = c.text_strong, italic = true },
  Error = { fg = c.state_error },
  ["@markup.heading.1.delimiter.vimdoc"] = { fg = c.text_faint },
  ["@markup.heading.2.delimiter.vimdoc"] = { fg = c.text_faint },
  NvimInternalError = { fg = c.text_on_accent, bg = c.state_error },
  RedrawDebugClear = { bg = c.state_warning_bg },
  RedrawDebugComposed = { bg = c.state_added_bg },
  RedrawDebugRecompose = { bg = c.state_removed_bg },
  TelescopeNormal = { link = "NormalFloat" },
  TelescopeBorder = { link = "FloatBorder" },
  TelescopeTitle = { link = "FloatTitle" },
  TelescopeSelection = { link = "PmenuSel" },
  TelescopeMatching = { fg = c.accent_match },
  TelescopePromptCounter = { fg = c.text_faint },
  TelescopePreviewHyphen = { fg = c.text_faint },
  TelescopeResultsDiffUntracked = { fg = c.text_faint },
  CmpItemAbbrDeprecated = { fg = c.text_disabled, strikethrough = true },
  CmpItemAbbrMatch = { fg = c.accent_match },
  CmpItemAbbrMatchFuzzy = { link = "CmpItemAbbrMatch" },
  CmpItemKind = { fg = c.text_faint },
  CmpItemKindIcon = { fg = c.text_faint },
  CmpItemMenu = { fg = c.text_faint },
  DevIconDefault = { fg = c.accent_interactive },
  GitSignsCurrentLineBlame = { fg = c.text_disabled },
  GitSignsAddInline = { fg = c.state_added, bg = c.state_added_bg },
  GitSignsChangeInline = { fg = c.state_changed, bg = c.state_changed_bg },
  GitSignsDeleteInline = { fg = c.state_removed, bg = c.state_removed_bg },
  GitSignsDiffStaged = { link = "DiffChange" },
  GitSignsStagedAdd = { fg = c.state_hint },
  GitSignsStagedAddNr = { fg = c.state_hint },
  GitSignsStagedAddCul = { fg = c.state_hint },
  GitSignsStagedAddLn = { link = "GitSignsAddLn" },
  GitSignsStagedChange = { fg = c.state_hint },
  GitSignsStagedChangeNr = { fg = c.state_hint },
  GitSignsStagedChangeCul = { fg = c.state_hint },
  GitSignsStagedChangeLn = { link = "GitSignsChangeLn" },
  GitSignsStagedChangedelete = { fg = c.state_hint },
  GitSignsStagedChangedeleteNr = { fg = c.state_hint },
  GitSignsStagedChangedeleteCul = { fg = c.state_hint },
  GitSignsStagedChangedeleteLn = { link = "GitSignsChangedeleteLn" },
  GitSignsStagedDelete = { fg = c.state_hint },
  GitSignsStagedDeleteNr = { fg = c.state_hint },
  GitSignsStagedDeleteCul = { fg = c.state_hint },
  GitSignsStagedTopdelete = { fg = c.state_hint },
  GitSignsStagedTopdeleteNr = { fg = c.state_hint },
  GitSignsStagedTopdeleteCul = { fg = c.state_hint },
  GitSignsStagedUntracked = { fg = c.state_hint },
  GitSignsStagedUntrackedNr = { fg = c.state_hint },
  GitSignsStagedUntrackedCul = { fg = c.state_hint },
  GitSignsStagedUntrackedLn = { link = "GitSignsUntrackedLn" },
}

-- g:terminal_color_0 … 15
M.terminal = { c.ansi_black, c.ansi_red, c.ansi_green, c.ansi_yellow, c.ansi_blue, c.ansi_magenta, c.ansi_cyan, c.ansi_white, c.ansi_bright_black, c.ansi_bright_red, c.ansi_bright_green, c.ansi_bright_yellow, c.ansi_bright_blue, c.ansi_bright_magenta, c.ansi_bright_cyan, c.ansi_bright_white }

function M.load()
  vim.cmd("highlight clear")
  -- 'background' перезагружает тему из g:colors_name — меняем, пока имени нет
  vim.g.colors_name = nil
  if vim.o.background ~= "light" then
    vim.o.background = "light"
  end
  vim.g.colors_name = "uiu"
  for name, spec in pairs(M.groups) do
    vim.api.nvim_set_hl(0, name, spec)
  end
  for i, color in ipairs(M.terminal) do
    vim.g["terminal_color_" .. (i - 1)] = color
  end
end

return M
"
`;
