exports[`base16 snapshot 1`] = `
"# uiu — base16 scheme (light)
# generated by packages/theme-gen from theme/*.css — do not edit by hand
system: "base16"
name: "uiu light"
slug: "uiu-light"
author: "iwwwanow"
variant: "light"
palette:
  base00: "#ffffff" # surface-base
  base01: "#ebebeb" # surface-chrome
  base02: "#e0e0e0" # accent-menu-selection
  base03: "#a4a4a4" # syntax-comment
  base04: "#7a7a7a" # text-faint
  base05: "#292929" # text
  base06: "#000000" # text-strong
  base07: "#000000" # text-strong
  base08: "#bc0001" # ansi-red
  base09: "#8d5402" # ansi-yellow
  base0A: "#8d5402" # ansi-yellow
  base0B: "#017746" # ansi-green
  base0C: "#0266ab" # ansi-cyan
  base0D: "#0040ff" # ansi-blue
  base0E: "#a202a2" # ansi-magenta
  base0F: "#bc0001" # ansi-red
"
`;

exports[`delta snapshot 1`] = `
"# uiu — delta colors (light)
# generated by packages/theme-gen from theme/*.css — do not edit by hand
[delta]
	light = true
	syntax-theme = ansi
	minus-style = syntax "#fee9e5"
	minus-emph-style = "#bc0001" "#fee9e5"
	plus-style = syntax "#daf7e4"
	plus-emph-style = "#017746" "#daf7e4"
	file-style = "#000000"
	file-decoration-style = "#e0e0e0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#e0e0e0" box
	hunk-header-line-number-style = "#7a7a7a"
	line-numbers-zero-style = "#7a7a7a"
	line-numbers-minus-style = "#bc0001"
	line-numbers-plus-style = "#017746"
	line-numbers-left-style = "#e0e0e0"
	line-numbers-right-style = "#e0e0e0"
"
`;

