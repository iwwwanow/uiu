# uiu — delta colors (light)
# generated by packages/theme-gen from theme/*.css — do not edit by hand
[delta]
	light = true
	syntax-theme = ansi
	minus-style = syntax "#fee9e5"
	minus-emph-style = "#bc0001" "#fee9e5"
	plus-style = syntax "#daf7e4"
	plus-emph-style = "#017746" "#daf7e4"
	file-style = "#000000"
	file-decoration-style = "#e0e0e0" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#e0e0e0" box
	hunk-header-line-number-style = "#7a7a7a"
	line-numbers-zero-style = "#7a7a7a"
	line-numbers-minus-style = "#bc0001"
	line-numbers-plus-style = "#017746"
	line-numbers-left-style = "#e0e0e0"
	line-numbers-right-style = "#e0e0e0"
